%{
/*
 * lexer.l  -  FLEX lexical analyzer
 * ---------------------------------------------------------------
 * Reads characters and groups them into TOKENS for BISON.
 *
 * Token categories:
 *   1. Keywords        : DATE, TIME
 *   2. Numbers         : 29, 02, 2024, 10, 30 ...
 *   3. Date separators : -  and  /
 *   4. Time separator  : :
 *   5. Meridiem        : AM, PM
 *   6. Line end        : newline (one expression per line)
 *   7. Invalid         : any unknown character
 * Whitespace and #comments are skipped.
 * ---------------------------------------------------------------
 */

#include <stdio.h>
#include <string.h>
#include "date_time.h"
#include "parser.tab.h"   /* token names generated by BISON */

/* ----- Position information shared with parser.y ----- */
int  current_line       = 1;   /* line currently being read          */
int  token_start_col    = 1;   /* column where the last token began  */
int  statement_line     = 1;   /* line number of the current input   */
int  lex_error_reported = 0;   /* 1 after an unknown-character error */
int  header_printed     = 0;   /* 1 after "Line N: ..." was printed  */
char line_text[LINE_TEXT_SIZE] = "";  /* text of the current line    */

static int next_col      = 1;  /* column where the next token starts */
static int at_line_start = 1;  /* 1 until the first token of a line  */

/* Defined in parser.y */
extern void report_error(const char *kind, int column, const char *message);

/* Called automatically before every rule action (see YY_USER_ACTION).
 * It keeps track of the column and remembers the text of the line. */
static void track_token(const char *text, int length)
{
    token_start_col = next_col;
    next_col += length;

    /* Newlines, carriage returns and the empty end-of-file match are
     * not part of the line text. */
    if (length == 0 || text[0] == '\n' || text[0] == '\r') {
        return;
    }

    if (at_line_start) {
        /* Ignore leading spaces; start remembering at the first real token */
        if (text[0] == ' ' || text[0] == '\t') {
            return;
        }
        line_text[0]   = '\0';
        statement_line = current_line;
        header_printed = 0;
        at_line_start  = 0;
    }

    strncat(line_text, text, LINE_TEXT_SIZE - strlen(line_text) - 1);
}

#define YY_USER_ACTION track_token(yytext, yyleng);
%}

%option noyywrap
%option noinput
%option nounput
%option case-insensitive

DIGIT   [0-9]

%%

[ \t\r]+        { /* skip whitespace */ }

#.*             { /* skip comments (used in test_cases.txt) */ }

\n              { current_line++;
                  next_col = 1;
                  at_line_start = 1;
                  return NEWLINE; }

DATE            { return DATE_KW; }
TIME            { return TIME_KW; }
AM              { return AM; }
PM              { return PM; }

{DIGIT}+        { yylval.num = number_from_text(yytext);
                  return NUMBER; }

"-"             { return DASH; }
"/"             { return SLASH; }
":"             { return COLON; }

.               { char message[80];
                  snprintf(message, sizeof(message),
                           "unknown character '%s'", yytext);
                  report_error("LEXICAL ERROR", token_start_col, message);
                  lex_error_reported = 1;
                  return INVALID_CHAR; }

<<EOF>>         { /* If the last line has no newline, supply one so the
                     grammar (which expects NEWLINE) still works. */
                  if (!at_line_start) {
                      at_line_start = 1;
                      return NEWLINE;
                  }
                  return 0; }

%%
